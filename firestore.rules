rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    match /bot_sessions/{userId} {
      allow read, write: if true;
    }
  }
}
